# Copy this file to .env and add values from your Supabase project's API settings.
# Secret keys are server-only. Never expose them in browser code or builds.
ENVIRONMENT="development"

SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

CLIENT_ID=""
PLAID_SECRET=""
PLAID_MODE="sandbox" # sandbox | production
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
PLAID_TOKEN_ENCRYPTION_KEY=""

GROQ_KEY=""

# Optional. Extra admins for the team-only /admin page, comma separated. Normally you add admins as rows in the
# Supabase "Team Admin" table instead (supabase/migrations/20261114_team_admins.sql).
ADMIN_EMAILS=""